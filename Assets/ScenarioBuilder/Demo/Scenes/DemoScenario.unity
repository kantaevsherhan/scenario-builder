MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1951427611}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1f548d04f2ee9614993a5748686699f5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ScenarioBuilder.Runtime::ScenarioBuilder.UI.GuidedTour
  runner: {fileID: 1288183899}
  view: {fileID: 1951427613}
  intro:
  - target: {fileID: 201958168}
    title: "\u0421\u043F\u0438\u0441\u043E\u043A \u0437\u0430\u0434\u0430\u043D\u0438\u0439"
    text: "\u0417\u0434\u0435\u0441\u044C \u0432\u0441\u0435 \u0448\u0430\u0433\u0438 \u0441\u043C\u0435\u043D\u044B. \u0421\u0438\u043D\u0438\u0435 \u043D\u0443\u0436\u043D\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0441\u0435\u0439\u0447\u0430\u0441, \u0437\u0435\u043B\u0451\u043D\u044B\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u044B, \u043A\u0440\u0430\u0441\u043D\u044B\u0435 \u043F\u0440\u043E\u0432\u0430\u043B\u0435\u043D\u044B."
  - target: {fileID: 471688986}
    title: "\u041F\u0443\u043B\u044C\u0442 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F"
    text: "\u041A\u043D\u043E\u043F\u043A\u0438 \u0438 \u043F\u043E\u043B\u0437\u0443\u043D\u043E\u043A \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0442 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F. \u041A\u043D\u043E\u043F\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0436\u0434\u0451\u0442 \u0442\u0435\u043A\u0443\u0449\u0438\u0439 \u0448\u0430\u0433, \u043C\u0438\u0433\u0430\u0435\u0442 \u0441\u0438\u043D\u0438\u043C."
  - target: {fileID: 862060200}
    title: "\u042D\u0442\u043E \u0432\u044B"
    text: "\u0414\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C \u043A\u043B\u0430\u0432\u0438\u0448\u0430\u043C\u0438 WASD \u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u0430\u043C\u0438: \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u0432 \u0437\u043E\u043D\u044B \u0438 \u043A\u0430\u0441\u0430\u0439\u0442\u0435\u0441\u044C \u0441\u0442\u043E\u0435\u043A."
  - target: {fileID: 842666811}
    title: "\u0420\u0435\u0436\u0438\u043C\u044B"
    text: "\u0412 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0435 \u0435\u0441\u0442\u044C \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438 \u0438 \u0448\u0430\u0433 \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C. \u041D\u0430 \u044D\u043A\u0437\u0430\u043C\u0435\u043D\u0435 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043E\u043A \u043D\u0435\u0442, \u0430 \u043E\u0448\u0438\u0431\u043A\u0438 \u0441\u0442\u043E\u044F\u0442 \u0431\u0430\u043B\u043B\u043E\u0432."
  - target: {fileID: 1741724888}
    title: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438"
    text: "\u0417\u0434\u0435\u0441\u044C \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438 \u0438 \u044D\u0442\u043E\u0442 \u0442\u0443\u0440 \u043C\u043E\u0436\u043D\u043E \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0438\u043B\u0438 \u043F\u0440\u043E\u0439\u0442\u0438 \u0442\u0443\u0440 \u0437\u0430\u043D\u043E\u0432\u043E. Esc \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043E\u043A\u043D\u0430 \u0438 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438."
